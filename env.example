# Busy Bees Environment Variables
# Copy this file to .env.local and fill in your actual values

# ===============================================
# SITE CONFIGURATION
# ===============================================
NEXT_PUBLIC_SITE_URL=https://busybeesipc.com
NEXT_PUBLIC_SITE_NAME="Busy Bees Indoor Play Center"

# Contact Information
NEXT_PUBLIC_PHONE="(555) 123-BEES"
NEXT_PUBLIC_EMAIL="info@busybeesipc.com"
NEXT_PUBLIC_ADDRESS="123 Play Street, Fun City, FC 12345"

# Business Hours (24-hour format)
NEXT_PUBLIC_OPEN_HOUR=9
NEXT_PUBLIC_CLOSE_HOUR=18

# ===============================================
# SUPABASE (Required)
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
# ===============================================
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ===============================================
# STRIPE (Required for Payments)
# Get these from: https://dashboard.stripe.com/apikeys
# Use TEST keys for development, LIVE keys for production
# ===============================================
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ===============================================
# RESEND EMAIL SERVICE (Required for Emails)
# Get your API key from: https://resend.com/api-keys
# Verify your domain at: https://resend.com/domains
# ===============================================
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@busybeesipc.com

# ===============================================
# SENTRY ERROR MONITORING (Optional but Recommended)
# Get these from: https://sentry.io/settings/YOUR_ORG/projects/YOUR_PROJECT/keys/
# ===============================================
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
# SENTRY_AUTH_TOKEN=sntrys_...
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# ===============================================
# ANALYTICS (Optional)
# ===============================================
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
